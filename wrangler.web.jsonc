{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flag-paths-web",
  "compatibility_date": "2026-07-19",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Serve static assets first (incl. the prerendered /country/<slug>/ pages),
    // and fall back to the SPA for client routes like /planner and /country.
    "not_found_handling": "single-page-application"
  },
  "routes": [
    // Custom domain: Cloudflare auto-creates the DNS record + certificate for
    // the apex on deploy. www + the legacy atlas.thomphreys.com host 301 to
    // this apex via the flag-paths-redirect worker (scripts/redirect-worker/).
    {
      "pattern": "flagpaths.com",
      "custom_domain": true
    }
  ]
}
