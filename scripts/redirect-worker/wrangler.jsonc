{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flag-paths-redirect",
  "main": "worker.ts",
  "compatibility_date": "2026-07-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    // www → apex. Custom domain so Cloudflare creates the DNS record + cert.
    {
      "pattern": "www.flagpaths.com",
      "custom_domain": true
    },
    // Old home of the Atlas; DNS for this host already exists on the zone.
    {
      "pattern": "atlas.thomphreys.com/*",
      "zone_name": "thomphreys.com"
    }
  ]
}
